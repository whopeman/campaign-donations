# .htaccess (published as site/.htaccess)
# Project : Campaign Donations
# Date    : 2026-10-26
# Purpose : Security headers and caching for the static site on Apache.
# Change log:
#   2026-10-26  0.1.0  Initial version.
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'none'; style-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 day"
  ExpiresByType text/css "access plus 30 days"
</IfModule>
Options -Indexes
