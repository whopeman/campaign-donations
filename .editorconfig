# .editorconfig
# Project : Campaign Donations
# Date    : 2026-10-26
# Purpose : Consistent whitespace across editors.
# Change log:
#   2026-10-26  0.1.0  Initial settings.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false
